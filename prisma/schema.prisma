generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @unique
  name      String
  embedding Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String
  studentName String
  date        String
  time        String
  createdAt   DateTime @default(now())

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId])
}

model RecognitionEvent {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  status           String
  studentId        String?
  name             String?
  attendanceStatus String?
  source           String   @default("next-app")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@index([studentId])
}
